{
  "name": "daily-wire-demo",
  "version": "1.0.0",
  "description": "Static news website generated with vanilla Node.js and Tailwind CSS",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:html": "node build.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/style.css --minify",
    "build": "npm run clean && npm run build:html && npm run build:css",
    "watch": "node build.js --watch",
    "dev": "node build.js --watch --serve"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "tailwindcss": "^3.4.4"
  }
}
